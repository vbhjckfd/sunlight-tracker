{
  "manifest_version": 3,
  "name": "Sunlight Tracker for LUN.ua",
  "version": "1.0.2",
  "description": "Sun direction, sunrise/sunset times and building-shadow checks overlaid on LUN.ua residential complex maps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lun.ua/*",
        "https://*.lun.ua/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
